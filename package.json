{
  "name": "control-systems-js",
  "version": "1.0.0",
  "description": "Systems Control Utility Library",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brenopms/control-systems-js.git"
  },
  "license": "MIT",
  "files": [
    "dist/"
  ],
  "keywords": [
    "control",
    "control-systems",
    "engineering"
  ],
  "scripts": {
    "prepare": "husky",
    "prepublishOnly": "run-s build test:pkg",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "run-s build test:biome test:typecheck test:pkg test:unit test:coverage",
    "test:biome": "biome check .",
    "test:typecheck": "tsc --noEmit",
    "test:pkg": "publint && attw --pack .",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "watch:test": "vitest",
    "generate-docs": "typedoc",
    "release": "semantic-release"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "npm@11.19.0",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/github": "^12.0.10",
    "@vitest/coverage-v8": "^5.0.2",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.3",
    "publint": "^0.3.24",
    "semantic-release": "^25.0.9",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,json}": "biome check --write --no-errors-on-unmatched"
  },
  "overrides": {
    "std-env": "4.2.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "provenance": true
  }
}
