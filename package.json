{
  "name": "control-systems-js",
  "version": "1.0.0",
  "description": "Systems Control Utility Library",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "sideEffects": false,
  "repository": "https://github.com/Brenopms/control-systems-js",
  "license": "MIT",
  "files": [
    "dist/"
  ],
  "keywords": [
    "control",
    "control-systems",
    "engineering"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "run-s build test:biome test:typecheck test:unit test:coverage",
    "test:biome": "biome check .",
    "test:typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "watch:test": "vitest",
    "generate-docs": "typedoc ./src --includeVersion --out ./genDocs",
    "release": "semantic-release"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@vitest/coverage-v8": "^5.0.2",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "npm-run-all2": "^9.0.3",
    "semantic-release": "^25.0.9",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "std-env": "4.2.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  }
}
